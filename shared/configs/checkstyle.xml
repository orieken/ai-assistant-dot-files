<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Framework fitness-function floor — Checkstyle (Java)
  Source convention: shared/rules/java-conventions.md  (also CLAUDE.md § Java Quick Reference)
  CAP: 6  (cyclomatic complexity — enforces the framework-wide "< 7" rule)

  Drop this file into a project as checkstyle.xml (or merge into an existing one).
  Only the CyclomaticComplexity check is set here — this is a floor, not a full policy.
  Run via: mvn checkstyle:check -Dcheckstyle.config.location=checkstyle.xml
        or: gradle checkstyleMain (with the checkstyle plugin pointing at this file)
-->
<module name="Checker">
    <module name="TreeWalker">
        <!--
          CyclomaticComplexity: flag methods with complexity > max.
          max=6 means flag complexity > 6 (i.e., >= 7), enforcing the cap at 6.
        -->
        <module name="CyclomaticComplexity">
            <property name="max" value="6"/>
        </module>
    </module>
</module>
