# Path to the ai-assistant-dot-files repo clone.
# Used by search_ki to locate shared/knowledge/ and docs/adrs/.
AI_ASSISTANT_DOTFILES_PATH=/path/to/ai-assistant-dot-files

# Optional: override the sqlite BM25 index path for search_docs.
# Defaults to .claude/rag/docs-fts5.sqlite in the current working directory.
# DOCS_FTS_PATH=/absolute/path/to/docs-fts5.sqlite

# Optional: OpenTelemetry exporter (trace spans per tool invocation).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
